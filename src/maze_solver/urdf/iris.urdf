  <!-- Drone velocity control plugin -->
  <gazebo>
    <plugin name="iris_velocity_controller" filename="libgazebo_ros_planar_move.so">
      <ros>
        <namespace>/iris</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
      </ros>
      <body_name>base_link</body_name>
      <max_force>30.0</max_force>
      <max_torque>10.0</max_torque>
    </plugin>
  </gazebo>

  <!-- Downward-facing camera -->
  <gazebo reference="downward_camera_link">
    <sensor name="downward_camera" type="camera">
      <always_on>1</always_on>
      <update_rate>30.0</update_rate>
      <camera>
        <horizontal_fov>1.5708</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>50</far>
        </clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/iris</namespace>
          <remapping>image_raw:=downward_camera/image_raw</remapping>
          <remapping>camera_info:=downward_camera/camera_info</remapping>
        </ros>
        <frame_name>downward_camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

    <!-- Disable gravity for the drone -->
  <gazebo reference="iris/base_link">
    <gravity>false</gravity>
  </gazebo>
  
  <gazebo reference="iris/base_link_inertia">
    <gravity>false</gravity>
  </gazebo>

